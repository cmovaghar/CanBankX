@page "/register"
@using Frontend.Services
@inject AuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Open Account — CanBankX</PageTitle>

<div class="auth-page">
    <div class="bg-layer">
        <div class="bg-gradient"></div>
        <div class="bg-grid"></div>
        <div class="bg-glow glow-1"></div>
    </div>

    <div class="auth-panel register-panel">
        <div class="auth-panel-header">
            <a href="/" class="logo">
                <svg class="logo-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M12 2L19 8L12 14L5 8Z" fill="currentColor" opacity="0.95" />
                    <path d="M12 10L19 16L12 22L5 16Z" fill="currentColor" opacity="0.50" />
                </svg>
                <span class="logo-text">CanBankX</span>
            </a>
            <h2>Open Your Account</h2>
            <p>Join thousands of Canadians who trust CanBankX with their finances.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">⚠</span>
                @_errorMessage
            </div>
        }

        @if (_success)
        {
            <div class="alert alert-success">
                <span class="alert-icon">✓</span>
                Account created successfully! Redirecting to sign in…
            </div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleRegister" FormName="register">
                <DataAnnotationsValidator />

                <!-- Step indicator -->
                <div class="steps">
                    <div class="step @(_step >= 1 ? "active" : "") @(_step > 1 ? "done" : "")">
                        <span class="step-num">@(_step > 1 ? "✓" : "1")</span>
                        <span class="step-label">Credentials</span>
                    </div>
                    <div class="step-line @(_step > 1 ? "filled" : "")"></div>
                    <div class="step @(_step >= 2 ? "active" : "") @(_step > 2 ? "done" : "")">
                        <span class="step-num">@(_step > 2 ? "✓" : "2")</span>
                        <span class="step-label">Personal</span>
                    </div>
                    <div class="step-line @(_step > 2 ? "filled" : "")"></div>
                    <div class="step @(_step >= 3 ? "active" : "")">
                        <span class="step-num">3</span>
                        <span class="step-label">Address</span>
                    </div>
                </div>

                <!-- Step 1: Credentials -->
                @if (_step == 1)
                {
                    <div class="form-step">
                        <div class="field">
                            <label>Email Address</label>
                            <InputText @bind-Value="_model.Email" placeholder="you@example.com" type="email" autocomplete="email" />
                            <ValidationMessage For="() => _model.Email" />
                        </div>
                        <div class="field">
                            <label>Password</label>
                            <InputText @bind-Value="_model.Password" type="password" placeholder="Min. 8 characters" autocomplete="new-password" />
                            <ValidationMessage For="() => _model.Password" />
                        </div>
                        <div class="field">
                            <label>Confirm Password</label>
                            <InputText @bind-Value="_model.ConfirmPassword" type="password" placeholder="Repeat password" autocomplete="new-password" />
                            <ValidationMessage For="() => _model.ConfirmPassword" />
                        </div>
                        <button type="button" class="btn-primary btn-full" @onclick="NextStep">Continue →</button>
                    </div>
                }

                <!-- Step 2: Personal Info -->
                @if (_step == 2)
                {
                    <div class="form-step">
                        <div class="field-row">
                            <div class="field">
                                <label>First Name</label>
                                <InputText @bind-Value="_model.FirstName" placeholder="Jean" autocomplete="given-name" />
                                <ValidationMessage For="() => _model.FirstName" />
                            </div>
                            <div class="field">
                                <label>Last Name</label>
                                <InputText @bind-Value="_model.LastName" placeholder="Tremblay" autocomplete="family-name" />
                                <ValidationMessage For="() => _model.LastName" />
                            </div>
                        </div>
                        <div class="field">
                            <label>Date of Birth</label>
                            <InputDate @bind-Value="_model.DateOfBirth" />
                            <ValidationMessage For="() => _model.DateOfBirth" />
                        </div>
                        <div class="field">
                            <label>Phone Number</label>
                            <InputText @bind-Value="_model.PhoneNumber" placeholder="+1 (514) 555-0100" type="tel" autocomplete="tel" />
                            <ValidationMessage For="() => _model.PhoneNumber" />
                        </div>
                        <div class="btn-row">
                            <button type="button" class="btn-ghost" @onclick="() => _step = 1">← Back</button>
                            <button type="button" class="btn-primary" @onclick="NextStep">Continue →</button>
                        </div>
                    </div>
                }

                <!-- Step 3: Address -->
                @if (_step == 3)
                {
                    <div class="form-step">
                        <div class="field">
                            <label>Street Address</label>
                            <InputText @bind-Value="_model.Street" placeholder="123 Rue Sainte-Catherine" autocomplete="street-address" />
                            <ValidationMessage For="() => _model.Street" />
                        </div>
                        <div class="field-row">
                            <div class="field">
                                <label>City</label>
                                <InputText @bind-Value="_model.City" placeholder="Montréal" autocomplete="address-level2" />
                                <ValidationMessage For="() => _model.City" />
                            </div>
                            <div class="field field-sm">
                                <label>Province</label>
                                <InputSelect @bind-Value="_model.Province">
                                    <option value="">Select…</option>
                                    <option value="AB">AB</option>
                                    <option value="BC">BC</option>
                                    <option value="MB">MB</option>
                                    <option value="NB">NB</option>
                                    <option value="NL">NL</option>
                                    <option value="NS">NS</option>
                                    <option value="NT">NT</option>
                                    <option value="NU">NU</option>
                                    <option value="ON">ON</option>
                                    <option value="PE">PE</option>
                                    <option value="QC">QC</option>
                                    <option value="SK">SK</option>
                                    <option value="YT">YT</option>
                                </InputSelect>
                                <ValidationMessage For="() => _model.Province" />
                            </div>
                        </div>
                        <div class="field">
                            <label>Postal Code</label>
                            <InputText @bind-Value="_model.PostalCode" placeholder="H2X 1Y4" autocomplete="postal-code" />
                            <ValidationMessage For="() => _model.PostalCode" />
                        </div>
                        <div class="btn-row">
                            <button type="button" class="btn-ghost" @onclick="() => _step = 2">← Back</button>
                            <button type="submit" class="btn-primary" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner"></span>
                                    <span>Creating account…</span>
                                }
                                else
                                {
                                    <span>Open Account</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </EditForm>
        }

        <p class="auth-switch">Already have an account? <a href="/login">Sign in →</a></p>
    </div>
</div>

@code {
    private RegisterModel _model = new();
    private int _step = 1;
    private bool _isLoading = false;
    private bool _success = false;
    private string? _errorMessage;

    private void NextStep()
    {
        _step = Math.Min(_step + 1, 3);
    }

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = null;

        var (success, error) = await AuthService.RegisterAsync(_model);

        if (success)
        {
            _success = true;
            await Task.Delay(2000);
            Nav.NavigateTo("/login");
        }
        else
        {
            _errorMessage = error;
        }

        _isLoading = false;
    }
}

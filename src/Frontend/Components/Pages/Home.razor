@page "/"

<PageTitle>CanBankX — Private Banking</PageTitle>

<div class="landing">
    <!-- Ambient background -->
    <div class="bg-layer">
        <div class="bg-gradient"></div>
        <div class="bg-grid"></div>
        <div class="bg-glow glow-1"></div>
        <div class="bg-glow glow-2"></div>
    </div>

    <!-- Header -->
    <header class="landing-header">
        <div class="logo">
            <svg class="logo-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2L19 8L12 14L5 8Z" fill="currentColor" opacity="0.95" />
                <path d="M12 10L19 16L12 22L5 16Z" fill="currentColor" opacity="0.50" />
            </svg>
            <span class="logo-text">CanBankX</span>
        </div>
        <nav class="landing-nav">
            <a href="/login" class="nav-link">Sign In</a>
            <a href="/register" class="btn-primary">Open Account</a>
        </nav>
    </header>

    <!-- Hero -->
    <main class="hero">
        <div class="hero-content">
            <p class="hero-eyebrow">Private Banking, Reimagined</p>
            <h1 class="hero-headline">
                Your wealth,<br/>
                <em>precisely managed.</em>
            </h1>
            <p class="hero-sub">
                CanBankX offers institutional-grade financial tools for discerning individuals. 
                Secure, transparent, and built for the modern era.
            </p>
            <div class="hero-actions">
                <a href="/register" class="btn-primary btn-large">Open Your Account</a>
                <a href="/login" class="btn-ghost">Existing member →</a>
            </div>
        </div>

        <div class="hero-card">
            <div class="card-chip">
                <div class="chip-lines">
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>
            <div class="card-network">PREMIUM</div>
            <div class="card-number">•••• •••• •••• 4291</div>
            <div class="card-meta">
                <div>
                    <span class="card-label">Card Holder</span>
                    <span class="card-value">J. Doe</span>
                </div>
                <div>
                    <span class="card-label">Expires</span>
                    <span class="card-value">12 / 28</span>
                </div>
            </div>
        </div>
    </main>

    <!-- Stats strip -->
    <section class="stats-strip">
        <div class="stat">
            <span class="stat-number">$4.2B</span>
            <span class="stat-label">Assets Under Management</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
            <span class="stat-number">98.7%</span>
            <span class="stat-label">Client Retention</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
            <span class="stat-number">256-bit</span>
            <span class="stat-label">AES Encryption</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
            <span class="stat-number">24 / 7</span>
            <span class="stat-label">Client Support</span>
        </div>
    </section>

    <!-- Features -->
    <section class="features">
        <div class="feature">
            <div class="feature-icon">◈</div>
            <h3>Instant Transfers</h3>
            <p>Move funds anywhere in Canada within seconds. No delays, no hidden fees.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">◉</div>
            <h3>Real-time Analytics</h3>
            <p>Track every transaction with precision. Full visibility into your financial picture.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">◫</div>
            <h3>Vault Security</h3>
            <p>Multi-factor authentication protects every session. Your money is safe.</p>
        </div>
    </section>

    <footer class="landing-footer">
        <span>© 2026 CanBankX Corp.</span>
        <span class="footer-divider">·</span>
        <a href="#">Privacy</a>
        <span class="footer-divider">·</span>
        <a href="#">Terms</a>
    </footer>
</div>
